{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "prijsvergelijker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Dagelijks 06:00 NL-tijd: cron draait elke 5 min in 04:00–05:59 UTC; de handler doet alleen
  // iets als het in Europe/Amsterdam 06:xx is (zomer: 04 UTC, winter: 05 UTC), 4 listings per keer.
  "vars": { "ACTION_DREMPEL": "5.00" },
  "triggers": { "crons": ["*/5 4-5 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "prijsvergelijker",
      "database_id": "83e9f6cc-643b-49ae-ae91-2ef856fd1c49",
      "migrations_dir": "migrations"
    }
  ]
  // Secret (niet in dit bestand): API_KEY  ->  npx wrangler secret put API_KEY
}
